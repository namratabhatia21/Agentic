# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Which backend runs Claude - pick the one your credits are on:
#   anthropic = Claude API (Anthropic Console credits)       -> set ANTHROPIC_API_KEY
#   vertex    = Google Cloud Vertex AI (GCP credits)         -> set GCP_PROJECT_ID, GCP_REGION
#   bedrock   = Amazon Bedrock (AWS credits)                 -> set AWS_* credentials, AWS_REGION
LLM_PROVIDER=anthropic
MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = smarter but slower and more tokens)
EFFORT=medium

ANTHROPIC_API_KEY=

GCP_PROJECT_ID=
GCP_REGION=global
# For local docker runs on Vertex, mount ADC: see docs/CLOUD_CREDITS.md
# GOOGLE_APPLICATION_CREDENTIALS=/gcloud/application_default_credentials.json

AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Database passwords (used by docker-compose to initialise Postgres)
POSTGRES_PASSWORD=change-me
READONLY_PASSWORD=change-me-too

# Comma-separated API keys accepted in the X-API-Key header. Empty = no auth (dev only!)
API_KEYS=
RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=*
LOG_LEVEL=INFO

GRAFANA_PASSWORD=admin
