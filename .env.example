# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Which backend runs Claude - pick the one your credits are on:
#   anthropic = Claude API (Anthropic Console credits)       -> set ANTHROPIC_API_KEY
#   vertex    = Google Cloud Vertex AI (GCP credits)         -> set GCP_PROJECT_ID, GCP_REGION
#   bedrock   = Amazon Bedrock (AWS credits)                 -> set AWS_* credentials, AWS_REGION
#   huggingface = open-weight model on HF Inference Providers -> set HF_TOKEN, HF_CHAT_MODEL
LLM_PROVIDER=anthropic
MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = smarter but slower and more tokens)
EFFORT=medium

ANTHROPIC_API_KEY=

GCP_PROJECT_ID=
GCP_REGION=global
# For local docker runs on Vertex, mount ADC: see docs/CLOUD_CREDITS.md
# GOOGLE_APPLICATION_CREDENTIALS=/gcloud/application_default_credentials.json

# --- Hugging Face ---------------------------------------------------------
# Token from https://huggingface.co/settings/tokens (fine-grained, enable
# "Make calls to Inference Providers"). Enables image generation + text
# classification tools, and LLM_PROVIDER=huggingface. Hub search needs no token.
HF_TOKEN=
# "auto" picks the first available provider; or pin one, e.g. together, groq, fireworks-ai
HF_PROVIDER=auto
# Any chat model with tool calling on https://huggingface.co/models?inference_provider=all
HF_CHAT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Semantic search: the `embeddings` service (Text Embeddings Inference) runs this model.
# Changing the model? Set EMBEDDING_DIM to its vector size and recreate the DB volume.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Database passwords (used by docker-compose to initialise Postgres)
POSTGRES_PASSWORD=change-me
READONLY_PASSWORD=change-me-too

# Comma-separated API keys accepted in the X-API-Key header. Empty = no auth (dev only!)
API_KEYS=
RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=*
LOG_LEVEL=INFO

GRAFANA_PASSWORD=admin
